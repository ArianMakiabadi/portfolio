# Copy to server/.env for local dev (gitignored). On the VPS, systemd's
# EnvironmentFile= points at the real file instead.

# Listen port, bound to 127.0.0.1 (Nginx / Vite proxy /api here).
PORT=3001

# Set to "production" on the VPS: the server then refuses to start without
# both Telegram vars instead of falling back to the console transport.
# Leave blank for local dev.
NODE_ENV=

# Telegram delivery: each Inquiry arrives as a message from your bot. Leave
# both blank to use the console transport, which prints the would-be message
# instead of sending it (local dev only; refused when NODE_ENV=production).
# Setting only one fails at startup.
#
# Setup (once):
#   1. In Telegram, message @BotFather, send /newbot, and copy the token it gives you.
#   2. Open a chat with your new bot and send it any message (bots can't message you first).
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates in a browser and copy
#      result[0].message.chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone for the time shown in each Telegram message (IANA name, e.g.
# Europe/Berlin). Blank = UTC. An unknown name fails at startup.
OWNER_TZ=

# Key for hashing Visitor IPs in the logs. Unset = random per process, so
# hashes only correlate until restart. Generate with: openssl rand -hex 32
IP_HASH_SECRET=
